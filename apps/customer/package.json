{
  "name": "@hotpot/customer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "build": "expo export --platform web --output-dir dist && node scripts/lock-pwa-viewport.mjs && node ../../scripts/qa/inject-brand-manifest.mjs customer",
    "icons:generate": "node scripts/generate-icons.mjs",
    "prestart": "npm run icons:generate",
    "preandroid": "npm run icons:generate",
    "preweb": "npm run icons:generate",
    "prebuild": "npm run icons:generate",
    "android:prebuild": "node scripts/prebuild-android.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-auth-session": "~7.0.11",
    "expo-crypto": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-native": "0.81.6",
    "react-native-safe-area-context": "5.6.2",
    "react-native-web": "0.21.4",
    "leaflet": "1.9.4",
    "@expo/vector-icons": "^15.0.3",
    "expo-notifications": "~0.32.17"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~10.0.0",
    "pngjs": "3.4.0",
    "@types/leaflet": "1.9.21"
  }
}
