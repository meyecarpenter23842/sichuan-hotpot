{
  "expo": {
    "name": "Sichuan Hotpot",
    "slug": "sichuan-hotpot-customer",
    "scheme": [
      "sichuanhotpot",
      "vn.sichuanhotpot.customer"
    ],
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "vn.sichuanhotpot.customer",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "name": "Sichuan Hotpot",
      "shortName": "Sichuan",
      "bundler": "metro",
      "output": "single",
      "themeColor": "#B3262D",
      "backgroundColor": "#FFFFFF",
      "favicon": "./public/icon-192-v20261016d.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép Sichuan Hotpot dùng vị trí để hỗ trợ địa chỉ giao hàng."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "customer-orders-v1",
          "color": "#B3262D"
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
