# Public values only. Never put a Google Client Secret, session secret or DB URL here.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Hero is publicly readable; do not put write credentials in Expo.
# Expected URL after actual upload (image object must exist in R2):
# https://pub-63ed7b1c33514906ab6e2d82f41bffce.r2.dev/system-image/login-hero.png
# Server: GOOGLE_CLIENT_ID and optional GOOGLE_WEB_CLIENT_ID/GOOGLE_ANDROID_CLIENT_ID
# must match the public client ID tokens accepted by the NestJS API.

# Optional web map XYZ tiles URL and legally required attribution (public map rendering only).
# EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
# Android standalone Google Maps SDK key: set GOOGLE_MAPS_ANDROID_KEY in build environment only.
