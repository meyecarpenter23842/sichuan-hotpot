{
  "expo": {
    "name": "Hotpot Retail",
    "slug": "sichuan-hotpot-retail",
    "version": "0.1.0",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "web": {
      "name": "Lẩu Tứ Xuyên — Bán tại quán",
      "shortName": "Hotpot Retail",
      "bundler": "metro",
      "output": "single",
      "themeColor": "#8C2028",
      "backgroundColor": "#FFFFFF"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "scheme": "sichuanhotpotretail",
    "newArchEnabled": true,
    "orientation": "default",
    "android": {
      "package": "vn.sichuanhotpot.retail",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "retail-qr-v1",
          "color": "#942B35"
        }
      ],
      "./plugins/with-qr-sound.cjs"
    ],
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
