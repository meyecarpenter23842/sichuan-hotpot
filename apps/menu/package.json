{
  "name": "@hotpot/menu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sichuan Hotpot menu Expo Web PWA foundation",
  "main": "./index.ts",
  "scripts": {
    "start": "expo start --web",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "build": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "expo": "~54.0.37",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-native": "0.81.6",
    "react-native-web": "0.21.4",
    "react-native-safe-area-context": "5.6.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~10.0.0"
  }
}
