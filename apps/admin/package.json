{
  "name": "@hotpot/admin",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Independent P4.1 Sichuan Hotpot staff app (Android Expo and Admin PWA)",
  "main": "./index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "build": "expo export --platform web --output-dir dist",
    "icons:generate": "node scripts/generate-icons.mjs",
    "prebuild": "npm run icons:generate",
    "prestart": "npm run icons:generate",
    "preweb": "npm run icons:generate",
    "preandroid": "npm run icons:generate"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-secure-store": "~15.0.8",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-native": "0.81.6",
    "react-native-safe-area-context": "5.6.2",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~10.0.0",
    "pngjs": "3.4.0"
  }
}
