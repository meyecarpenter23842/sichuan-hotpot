{
  "expo": {
    "name": "Sichuan Hotpot Admin",
    "slug": "sichuan-hotpot-admin",
    "scheme": "sichuanhotpotadmin",
    "version": "0.4.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "newArchEnabled": true,
    "android": {
      "package": "vn.sichuanhotpot.admin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "name": "Sichuan Hotpot Admin",
      "shortName": "Hotpot Admin",
      "bundler": "metro",
      "output": "single",
      "themeColor": "#B3262D",
      "backgroundColor": "#FFFFFF",
      "favicon": "./public/icon-192-v20261016d.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "photosPermission": "Cho phép chọn ảnh danh mục và topping cho thực đơn cửa hàng."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "../../sound-native-android.mp3"
          ],
          "defaultChannel": "new-orders-v1",
          "color": "#B3262D"
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
