// P1.2 baseline: DEV/CI only. No production connection or migration is authorized.
// Amounts use integer VND. All UTC instants use timestamptz. Customer-sensitive
// coordinates and address snapshots must be restricted to authorized API roles.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  KITCHEN
  DRIVER
  CUSTOMER
  WAITER
  CASHIER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  DELIVERED
  CANCELED
  DELIVERY_FAILED
}

enum PaymentMethod {
  COD
  QR
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum OrderItemPricingMode {
  LEGACY
  SEPARATE
}

enum ProductKind {
  STANDARD
  COMBO
}

enum ComboSnapshotKind {
  FIXED
  CHOICE
}

enum DeliveryPricingMode {
  DISTANCE
  ZONE
}

enum PushScope {
  CUSTOMER
  STAFF
}

enum PushTransport {
  WEB_PUSH
  FCM
}

// Dining data is separate from delivery orders; no fake customer/address.
enum DiningSessionStatus {
  OPEN
  CHECKOUT
  CLOSED
}
enum DiningTicketSource {
  STAFF
  QR
}
enum DiningTicketStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PREPARING
  READY
  SERVED
  CANCELED
}
enum DiningPaymentMethod {
  CASH
  QR
}
enum DiningPaymentStatus {
  PENDING
  CONFIRMED
  VOIDED
  REFUNDED
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  clerkSubject       String?              @unique @db.VarChar(255) // Legacy DEV-only; do not populate new accounts
  role               Role                 @default(CUSTOMER)
  phoneE164          String?              @db.VarChar(20)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)
  branchMemberships  BranchMember[]
  addresses          Address[]
  orders             Order[]              @relation("CustomerOrders")
  assignedDeliveries DeliveryAssignment[] @relation("AssignedDriver")
  statusChanges      OrderStatusHistory[] @relation("StatusActor")
  orderEdits         OrderEditAudit[]      @relation("OrderEditActor")
  authIdentities     AuthIdentity[]
  localCredential    LocalCredential?
  authSessions       AuthSession[]
  pushEndpoints      PushEndpoint[]
  diningSessionsOpened DiningSession[]   @relation("DiningSessionOpenedBy")
  diningSessionsClosed DiningSession[]   @relation("DiningSessionClosedBy")
  diningTicketsCreated DiningTicket[]    @relation("DiningTicketCreatedBy")
  diningTicketsReviewed DiningTicket[]   @relation("DiningTicketReviewedBy")
  diningPaymentsRecorded DiningPayment[] @relation("DiningPaymentRecordedBy")
  diningPaymentsConfirmed DiningPayment[] @relation("DiningPaymentConfirmedBy")
  diningAuditEvents  DiningAuditEvent[] @relation("DiningAuditActor")
}

model Branch {
  id                String                  @id @default(uuid()) @db.Uuid
  code              String                  @unique @db.VarChar(50)
  name              String                  @db.VarChar(200)
  address           String?                 @db.VarChar(500)
  catalogVersion    String?                 @db.VarChar(40)
  provinceCode      String?                 @db.VarChar(24)
  wardCode          String?                 @db.VarChar(24)
  latitude          Decimal                 @db.Decimal(10, 7)
  longitude         Decimal                 @db.Decimal(10, 7)
  isActive          Boolean                 @default(true)
  catalogRevision   Int                     @default(0)
  createdAt         DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(6)
  memberships       BranchMember[]
  categories        CatalogCategory[]
  modifierLibrary   ModifierGroup[]
  homeOffers        HomeOffer[]
  homeHeroConfig    HomeHeroConfig?
  homeHeroSlides    HomeHeroSlide[]
  homePopupConfig   HomePopupConfig?
  homePopupSlides   HomePopupSlide[]
  chatbotConfig     ChatbotConfig?
  deliveryPolicies  DeliveryPolicyVersion[]
  openingHours      BranchOpeningHour[]
  orders            Order[]
  pushEndpoints      PushEndpoint[]
  diningAreas        DiningArea[]
  diningTables       DiningTable[]
  diningSessions     DiningSession[]
}

model BranchMember {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([branchId, userId])
  @@index([userId])
}

// Configurable per-branch weekly opening hours. Server stores local HH:mm in
// Asia/Ho_Chi_Minh (0=Sunday). No fake schedule is created automatically.
// Durable outbox for safe cleanup of replaced/deleted product images in R2.
// An image is never deleted while a Product still references its key.
model R2ImageCleanup {
  key       String   @id @db.VarChar(512)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model BranchOpeningHour {
  branchId  String   @db.Uuid
  weekday   Int
  opensAt   String   @db.VarChar(5)
  closesAt  String   @db.VarChar(5)
  isClosed  Boolean  @default(false)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([branchId, weekday])
}

model DeliveryPolicyVersion {
  id                            String   @id @default(uuid()) @db.Uuid
  branchId                      String   @db.Uuid
  version                       Int
  acceptingOrders               Boolean
  pricingMode                   DeliveryPricingMode @default(DISTANCE)
  // Legacy distance fields remain nullable on new ZONE versions; old versions stay intact.
  baseMeters                    Int?
  baseFeeVnd                    Int?
  extraStepMeters               Int?
  extraStepFeeVnd               Int?
  maxRoadMeters                 Int?
  minSubtotalVnd                Int
  freeDeliveryAtSubtotalVnd     Int?
  createdAt                     DateTime @default(now()) @db.Timestamptz(6)
  branch                        Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orders                        Order[]
  zones                         DeliveryZone[]

  @@unique([branchId, version])
  @@index([branchId, createdAt])
}

// Zone rates are immutable children of an immutable policy version.
// Each zone represents a group of current wards, or a province fallback when wardCodes is empty.
model DeliveryZone {
  id              String                @id @default(uuid()) @db.Uuid
  policyVersionId String                @db.Uuid
  name            String                @db.VarChar(160)
  catalogVersion  String                @db.VarChar(40)
  provinceCode    String                @db.VarChar(24)
  wardCodes       String[]              @default([])
  feeVnd          Int
  isActive        Boolean               @default(true)
  policy          DeliveryPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  orders          Order[]

  @@index([policyVersionId, provinceCode])
}

model CatalogCategory {
  id        String    @id @default(uuid()) @db.Uuid
  branchId  String    @db.Uuid
  name      String    @db.VarChar(160)
  sortOrder Int       @default(0)
  imageKey  String?   @db.VarChar(512)
  isPublished Boolean @default(true)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  products  Product[]

  @@unique([branchId, name])
  @@index([branchId, sortOrder])
}

model Product {
  id          String         @id @default(uuid()) @db.Uuid
  categoryId  String         @db.Uuid
  name        String         @db.VarChar(200)
  description String?        @db.VarChar(1200)
  ingredients String?        @db.VarChar(1200)
  productNotes String?       @db.VarChar(800)
  allergenNotice String?     @db.VarChar(800)
  priceVnd    Int
  kind        ProductKind    @default(STANDARD)
  isAvailable Boolean        @default(true)
  isFeatured  Boolean        @default(false)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)
  category    CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  modifierGroups ModifierGroup[]
  modifierAssignments ProductModifierGroupAssignment[]
  imageKey    String?        @db.VarChar(512)
  orderItems  OrderItem[]
  comboFixedItems ProductComboFixedItem[] @relation("ComboParentFixed")
  usedAsComboFixed ProductComboFixedItem[] @relation("ComboChildFixed")
  comboGroups ProductComboGroup[]
  usedAsComboOption ProductComboOption[]
  orderComboSnapshots OrderItemComboSnapshot[]
  diningTicketItems DiningTicketItem[]

  @@index([categoryId, isAvailable])
  @@index([categoryId, sortOrder])
  @@index([isFeatured])
}

model ProductComboFixedItem {
  id             String   @id @default(uuid()) @db.Uuid
  comboProductId String   @db.Uuid
  childProductId String   @db.Uuid
  variantId      String?  @db.Uuid
  quantity       Int      @default(1)
  sortOrder      Int      @default(0)
  comboProduct   Product  @relation("ComboParentFixed", fields: [comboProductId], references: [id], onDelete: Restrict)
  childProduct   Product  @relation("ComboChildFixed", fields: [childProductId], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation("ComboFixedVariant", fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([comboProductId, childProductId])
  @@index([comboProductId, sortOrder])
  @@index([childProductId])
  @@index([variantId])
}

model ProductComboGroup {
  id             String               @id @default(uuid()) @db.Uuid
  comboProductId String               @db.Uuid
  name           String               @db.VarChar(160)
  minSelect      Int                  @default(1)
  maxSelect      Int                  @default(1)
  sortOrder      Int                  @default(0)
  comboProduct   Product              @relation(fields: [comboProductId], references: [id], onDelete: Restrict)
  options        ProductComboOption[]
  modifierOptions ProductComboModifierOption[]

  @@unique([comboProductId, name])
  @@index([comboProductId, sortOrder])
}

model ProductComboOption {
  id             String            @id @default(uuid()) @db.Uuid
  groupId        String            @db.Uuid
  childProductId String            @db.Uuid
  variantId      String?           @db.Uuid
  quantity       Int               @default(1)
  priceDeltaVnd  Int               @default(0)
  sortOrder      Int               @default(0)
  group          ProductComboGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  childProduct   Product           @relation(fields: [childProductId], references: [id], onDelete: Restrict)
  variant        ProductVariant?   @relation("ComboOptionVariant", fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([groupId, childProductId])
  @@index([groupId, sortOrder])
  @@index([childProductId])
  @@index([variantId])
}

model ProductComboModifierOption {
  id               String            @id @default(uuid()) @db.Uuid
  groupId          String            @db.Uuid
  modifierOptionId String            @db.Uuid
  quantity         Int               @default(1)
  priceDeltaVnd    Int               @default(0)
  sortOrder        Int               @default(0)
  group            ProductComboGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  modifierOption   ModifierOption    @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@unique([groupId, modifierOptionId])
  @@index([groupId, sortOrder])
  @@index([modifierOptionId])
}

model ProductVariant {
  id            String    @id @default(uuid()) @db.Uuid
  productId     String    @db.Uuid
  name          String    @db.VarChar(160)
  priceDeltaVnd Int       @default(0)
  isAvailable   Boolean   @default(true)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems    OrderItem[]
  comboFixedItems ProductComboFixedItem[] @relation("ComboFixedVariant")
  comboOptions ProductComboOption[] @relation("ComboOptionVariant")
  orderComboSnapshots OrderItemComboSnapshot[] @relation("OrderComboVariant")
  diningTicketItems DiningTicketItem[]

  @@unique([productId, name])
}

// DEV/CI migration only. Admin will configure real option groups in P4.
// Existing ModifierGroup/ModifierOption IDs become branch-scoped reusable templates.
// productId remains a nullable legacy origin for read compatibility and old test fixtures;
// active attachments are an explicit M:N relation, never an implicit cross-branch lookup.
model ModifierGroup {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String?  @db.Uuid
  branchId    String?  @db.Uuid
  name        String   @db.VarChar(160)
  minSelect   Int      @default(0)
  maxSelect   Int      @default(1)
  sortOrder   Int      @default(0)
  isAvailable Boolean  @default(true)
  imageKey    String?  @db.VarChar(512)
  product     Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  options     ModifierOption[]
  assignments ProductModifierGroupAssignment[]

  @@unique([productId, name])
  @@index([productId, sortOrder])
  @@index([branchId, sortOrder])
}

model ProductModifierGroupAssignment {
  productId String @db.Uuid
  groupId   String @db.Uuid
  sortOrder Int    @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([productId, groupId])
  @@index([groupId])
}

model ModifierOption {
  id            String         @id @default(uuid()) @db.Uuid
  groupId       String         @db.Uuid
  name          String         @db.VarChar(160)
  priceDeltaVnd Int            @default(0)
  isAvailable   Boolean        @default(true)
  imageKey      String?        @db.VarChar(512)
  group         ModifierGroup  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  orderSnapshots OrderItemModifierSnapshot[]
  comboOptions ProductComboModifierOption[]
  orderComboSnapshots OrderItemComboSnapshot[] @relation("OrderComboModifierOption")

  @@unique([groupId, name])
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  label      String   @db.VarChar(100)
  line1      String   @db.VarChar(500)
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  // Old addresses remain unmapped until the customer confirms the administrative codes.
  catalogVersion String? @db.VarChar(40)
  provinceCode String? @db.VarChar(24)
  wardCode String? @db.VarChar(24)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model PushEndpoint {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  branchId  String?       @db.Uuid
  scope     PushScope
  transport PushTransport
  token     String        @unique @db.Text
  p256dh    String?       @db.VarChar(256)
  auth      String?       @db.VarChar(128)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
  @@index([branchId, scope])
}

model Order {
  id                       String                 @id @default(uuid()) @db.Uuid
  branchId                 String                 @db.Uuid
  customerId               String                 @db.Uuid
  deliveryPolicyVersionId  String                 @db.Uuid
  idempotencyKey           String                 @db.VarChar(128)
  requestHash              String?                @db.VarChar(64)
  phoneSnapshot            String?                @db.VarChar(20)
  customerNote             String?                @db.VarChar(500)
  status                   OrderStatus            @default(PENDING)
  subtotalVnd              Int
  deliveryFeeVnd           Int
  totalVnd                 Int
  roadDistanceMeters       Int?
  pricingMode              DeliveryPricingMode @default(DISTANCE)
  zoneId                   String?                @db.Uuid
  zoneNameSnapshot         String?                @db.VarChar(160)
  provinceCodeSnapshot     String?                @db.VarChar(24)
  wardCodeSnapshot         String?                @db.VarChar(24)
  catalogVersionSnapshot   String?                @db.VarChar(40)
  addressLineSnapshot      String                 @db.VarChar(500)
  latitudeSnapshot         Decimal                @db.Decimal(10, 7)
  longitudeSnapshot        Decimal                @db.Decimal(10, 7)
  createdAt                DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(6)
  branch                   Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer                 User                   @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  deliveryPolicyVersion    DeliveryPolicyVersion  @relation(fields: [deliveryPolicyVersionId], references: [id], onDelete: Restrict)
  zone                     DeliveryZone?          @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  items                    OrderItem[]
  statusHistory            OrderStatusHistory[]
  edits                    OrderEditAudit[]
  deliveryAssignment       DeliveryAssignment?
  payment                  Payment?

  @@unique([customerId, idempotencyKey])
  @@index([branchId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([zoneId])
}

model OrderItem {
  id            String                      @id @default(uuid()) @db.Uuid
  orderId       String                      @db.Uuid
  productId     String?                     @db.Uuid
  variantId     String?                     @db.Uuid
  productName   String                      @db.VarChar(200)
  variantName   String?                     @db.VarChar(160)
  pricingMode   OrderItemPricingMode        @default(LEGACY)
  quantity      Int
  unitPriceVnd  Int
  lineTotalVnd  Int
  order         Order                       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product       Product?                    @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       ProductVariant?             @relation(fields: [variantId], references: [id], onDelete: SetNull)
  modifiers     OrderItemModifierSnapshot[]
  comboItems    OrderItemComboSnapshot[]

  @@index([orderId])
  @@index([variantId])
}

model OrderItemModifierSnapshot {
  id           String          @id @default(uuid()) @db.Uuid
  orderItemId  String          @db.Uuid
  optionId     String?         @db.Uuid
  name         String          @db.VarChar(160)
  priceVnd     Int
  orderItem    OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  option       ModifierOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([optionId])
}

model OrderItemComboSnapshot {
  id           String            @id @default(uuid()) @db.Uuid
  orderItemId  String            @db.Uuid
  productId    String?           @db.Uuid
  variantId    String?           @db.Uuid
  modifierOptionId String?       @db.Uuid
  kind         ComboSnapshotKind
  groupName    String?           @db.VarChar(160)
  productName  String            @db.VarChar(200)
  variantName  String?           @db.VarChar(160)
  quantity     Int
  priceDeltaVnd Int              @default(0)
  sortOrder    Int               @default(0)
  orderItem    OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product      Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant?   @relation("OrderComboVariant", fields: [variantId], references: [id], onDelete: SetNull)
  modifierOption ModifierOption?  @relation("OrderComboModifierOption", fields: [modifierOptionId], references: [id], onDelete: SetNull)

  @@index([orderItemId, sortOrder])
  @@index([productId])
  @@index([variantId])
  @@index([modifierOptionId])
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  actorId    String?      @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?      @db.VarChar(500)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor      User?        @relation("StatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model OrderEditAudit {
  id                String      @id @default(uuid()) @db.Uuid
  orderId           String      @db.Uuid
  actorId           String?     @db.Uuid
  reason            String      @db.VarChar(500)
  status            OrderStatus
  beforeSubtotalVnd Int
  afterSubtotalVnd  Int
  beforeTotalVnd    Int
  afterTotalVnd     Int
  beforeItems       Json        @db.JsonB
  afterItems        Json        @db.JsonB
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor             User?       @relation("OrderEditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
}

model DeliveryAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @unique @db.Uuid
  driverId   String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(6)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  driver     User     @relation("AssignedDriver", fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId, assignedAt])
}

model Payment {
  id         String         @id @default(uuid()) @db.Uuid
  orderId    String         @unique @db.Uuid
  method     PaymentMethod
  status     PaymentStatus  @default(PENDING)
  amountVnd     Int
  qrBankBin     String?        @db.VarChar(6)
  qrAccountNo   String?        @db.VarChar(19)
  qrAccountName String?        @db.VarChar(80)
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(6)
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
}


// A Google identity binds the immutable Google sub, not editable email/name.
enum AuthProvider {
  GOOGLE
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String       @db.VarChar(255)
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model LocalCredential {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  normalizedUsername String   @unique @db.VarChar(32)
  passwordHash       String   @db.VarChar(255)
  verifiedEmail      String?  @unique @db.VarChar(254)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)
  user               User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(64)
  expiresAt        DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

enum EmailChallengePurpose {
  REGISTER
  RESET_PASSWORD
}

model EmailChallenge {
  id                  String                @id @default(uuid()) @db.Uuid
  email               String                @db.VarChar(254)
  purpose             EmailChallengePurpose
  codeHash            String                @db.VarChar(64)
  normalizedUsername  String?               @db.VarChar(32)
  pendingPasswordHash String?               @db.VarChar(255)
  expiresAt           DateTime              @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(6)
  usedAt              DateTime?             @db.Timestamptz(6)
  attempts            Int                   @default(0)

  @@unique([email, purpose])
  @@index([expiresAt])
}

 
// Branch-scoped editorial promotions. These NEVER alter cart/checkout prices.
model HomeOffer {
  id          String    @id @default(uuid()) @db.Uuid
  branchId    String    @db.Uuid
  title       String    @db.VarChar(160)
  summary     String    @db.VarChar(360)
  body        String    @db.VarChar(4000)
  imageKey    String?   @db.VarChar(512)
  sortOrder   Int       @default(0)
  enabled     Boolean   @default(false)
  startAt     DateTime? @db.Timestamptz(6)
  endAt       DateTime? @db.Timestamptz(6)
  ctaTarget   String?   @db.VarChar(16)
  revision    Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, enabled, sortOrder])
  @@index([branchId, startAt, endAt])
}


