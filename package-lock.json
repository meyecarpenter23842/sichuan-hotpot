{
  "name": "sichuan-hotpot",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "sichuan-hotpot",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "5.9.3"
      }
    },
    "apps/admin": {
      "name": "@hotpot/admin",
      "version": "0.1.0",
      "private": true
    },
    "node_modules/@hotpot/admin": {
      "resolved": "apps/admin",
      "link": true
    },
    "apps/api": {
      "name": "@hotpot/api",
      "version": "0.1.0",
      "private": true
    },
    "node_modules/@hotpot/api": {
      "resolved": "apps/api",
      "link": true
    },
    "apps/customer": {
      "name": "@hotpot/customer",
      "version": "0.1.0",
      "private": true
    },
    "node_modules/@hotpot/customer": {
      "resolved": "apps/customer",
      "link": true
    },
    "packages/shared": {
      "name": "@hotpot/shared",
      "version": "0.1.0"
    },
    "node_modules/@hotpot/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/ui": {
      "name": "@hotpot/ui",
      "version": "0.1.0",
      "private": true
    },
    "node_modules/@hotpot/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "dev": true,
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    }
  }
}
