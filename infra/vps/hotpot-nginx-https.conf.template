# Not enabled until the operator supplies DNS and obtains a real certificate.
server {
    listen 80;
    server_name API_DOMAIN;
    access_log off;
    location /.well-known/acme-challenge/ { root /var/lib/sichuan-hotpot/acme; }
    location / { return 308 https://API_DOMAIN$request_uri; }
}
server {
    listen 443 ssl;
    server_name API_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/API_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/API_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/hotpot-error.log crit;
    client_max_body_size 32k;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
}
