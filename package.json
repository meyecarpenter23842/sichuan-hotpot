{
  "name": "sichuan-hotpot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <26"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "node scripts/check-source.mjs && node scripts/check-ui-references.mjs",
    "ui:reference:check": "node scripts/check-ui-references.mjs",
    "typecheck": "tsc -p packages/shared/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json",
    "test": "npm run build && node --test packages/shared/test/*.test.mjs packages/ui/test/*.test.mjs apps/api/test/*.test.mjs scripts/test/*.test.mjs",
    "build": "tsc -p packages/shared/tsconfig.json && tsc -p apps/api/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "prisma:validate": "prisma validate --schema apps/api/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^22.16.0"
  }
}
